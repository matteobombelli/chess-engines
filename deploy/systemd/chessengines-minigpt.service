[Unit]
Description=Chess Engines MiniGPT bot API
After=network.target

[Service]
Type=simple
User=hs
Group=hs
WorkingDirectory=/home/hs/chess-engines
Environment=MINIGPT_BIND_ADDRESS=127.0.0.1:3008
Environment=MINIGPT_MODEL_PATH=/home/hs/chess-engines/artifacts/minigpt/current/model.onnx
Environment=MINIGPT_MANIFEST_PATH=/home/hs/chess-engines/artifacts/minigpt/current/manifest.json
ExecStart=/home/hs/chess-engines/target/release/minigpt
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
